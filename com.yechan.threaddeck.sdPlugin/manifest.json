{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Actions": [
    {
      "Controllers": [
        "Keypad"
      ],
      "Icon": "images/action",
      "Name": "Weekly Codex quota",
      "States": [
        {
          "Image": "images/key",
          "ShowTitle": false
        }
      ],
      "Tooltip": "Shows remaining weekly Codex capacity as a ring. Press to refresh now.",
      "UserTitleEnabled": false,
      "UUID": "com.yechan.threaddeck.weekly"
    },
    {
      "Controllers": [
        "Keypad"
      ],
      "Icon": "images/action",
      "Name": "Codex task",
      "PropertyInspectorPath": "property-inspector/index.html",
      "States": [
        {
          "Image": "images/key",
          "ShowTitle": false
        }
      ],
      "Tooltip": "Choose Current or Top 1–8 in the Property Inspector. Tap to open it, or hold for 0.55 seconds to dictate and submit a follow-up.",
      "UserTitleEnabled": false,
      "UUID": "com.yechan.threaddeck.thread1"
    },
    {
      "Controllers": [
        "Keypad"
      ],
